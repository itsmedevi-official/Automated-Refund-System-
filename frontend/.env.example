# Optional overrides for the frontend (copy to .env.local).

# JSON-RPC endpoint used for read-only calls when MetaMask is not connected.
# Defaults to the value written into src/config.json by backend/scripts/deploy.js.
VITE_RPC_URL=http://127.0.0.1:8545

# Optional: Azure Maps subscription key used to show a human readable address
# next to the captured coordinates. Leave empty to run completely offline.
VITE_AZURE_MAPS_KEY=
