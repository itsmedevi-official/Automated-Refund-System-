# Copy this file to backend/.env (scripts/deploy.js updates ESCROW_CONTRACT automatically).
# Local Hardhat demo - never use these values with real funds.

# Address of the deployed SmartEscrow contract (filled by scripts/deploy.js)
ESCROW_CONTRACT=

# Escrow agent / arbitrator. Defaults to the deployer account (#0) when empty.
ESCROW_AGENT_ADDRESS=

# Contract parameters applied at deployment time (contract defaults: 200 m / 60 s)
DISTANCE_THRESHOLD_METERS=200
DISPUTE_WINDOW_SECONDS=60

# Optional Sepolia deployment (only used with --network sepolia)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Print private keys of the local accounts in scripts/print-accounts.js
SHOW_PRIVATE_KEYS=false
